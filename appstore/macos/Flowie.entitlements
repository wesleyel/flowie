<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store: App Sandbox, plus read/write access to files the user
     picks in Open / Save panels (import, export), and outgoing connections
     for sync with a server the user sets up (Settings → Sync). The data
     lives in the sandbox container. scripts/package-appstore.sh adds the
     application and team identifiers, and iCloud (the container, CloudKit
     and push) for sync through iCloud, to the signed build only. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
