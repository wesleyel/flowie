<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store: App Sandbox, plus read/write access to files the user
     picks in Open / Save panels (import, export). The data lives in the
     sandbox container. scripts/package-appstore.sh adds the application and
     team identifiers for the signed build. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
